<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Assessment</title>
    <style>
      .psychometric-section {
        margin-top: 40px;
      }

      .section-hint {
        color: #666;
        font-size: 14px;
        margin-bottom: 20px;
      }

      .psychometric-card {
        padding-bottom: 28px;
      }

      .slider-container {
        margin-top: 18px;
        text-align: center;
      }

      /* Slider base */
      .scale-slider {
        width: 100%;
        appearance: none;
        height: 6px;
        border-radius: 999px;
        background: linear-gradient(
          90deg,
          #ef4444 0%,
          #f59e0b 25%,
          #a3a3a3 50%,
          #22c55e 75%,
          #16a34a 100%
        );
        outline: none;
        cursor: pointer;
      }

      /* WebKit thumb */
      .scale-slider::-webkit-slider-thumb {
        appearance: none;
        width: 22px;
        height: 22px;
        background: #ffffff;
        border: 3px solid #4f46e5;
        border-radius: 50%;
        box-shadow: 0 6px 14px rgba(0, 0, 0, 0.15);
        transition: transform 0.15s ease;
      }

      .scale-slider::-webkit-slider-thumb:hover {
        transform: scale(1.15);
      }

      /* Firefox thumb */
      .scale-slider::-moz-range-thumb {
        width: 22px;
        height: 22px;
        background: #ffffff;
        border: 3px solid #4f46e5;
        border-radius: 50%;
      }

      /* Dynamic label */
      .scale-label {
        margin-top: 10px;
        font-weight: 600;
        font-size: 14px;
        color: #374151;
        transition: color 0.2s ease;
      }

      .assessment-container {
        max-width: 800px;
        margin: 40px auto;
        padding: 20px;
        font-family: Inter, system-ui, sans-serif;
      }

      .subtitle {
        color: #666;
        margin-bottom: 30px;
      }

      .question-card {
        background: #ffffff;
        border-radius: 14px;
        padding: 20px;
        margin-bottom: 20px;
        box-shadow: 0 8px 20px rgba(0, 0, 0, 0.06);
      }

      .question {
        font-weight: 600;
        margin-bottom: 12px;
      }

      .option {
        display: flex;
        gap: 10px;
        margin-bottom: 10px;
        cursor: pointer;
      }

      .option input {
        accent-color: #4f46e5;
      }

      .slider-wrapper {
        display: flex;
        align-items: center;
        gap: 12px;
      }

      input[type="range"] {
        flex: 1;
      }

      .submit-btn {
        margin-top: 30px;
        width: 100%;
        padding: 14px;
        border-radius: 12px;
        border: none;
        font-size: 16px;
        background: linear-gradient(135deg, #4f46e5, #22c55e);
        color: white;
        cursor: pointer;
      }
    </style>
  </head>
  <body>
    <div class="assessment-container">

      <h1>Career Assessment</h1>
      <p class="subtitle">Answer honestly. There are no right or wrong answers.</p>

      <!-- MCQ SECTION -->
      <section>
        <h2>Section 1: Situational Questions</h2>

        {{#each mcqQuestions}}
          <div class="question-card">
            <p class="question">{{this.question}}</p>

            {{#each this.options}}
              <label class="option">
                <input
                  type="radio"
                  name="mcq_{{this.id}}"
                  value="{{this.value}}"
                />
                <span>{{this.label}}</span>
              </label>
            {{/each}}
          </div>
        {{/each}}
      </section>

      <!-- SCALE SECTION -->
      <section class="psychometric-section">
        <h2>Section 2: Self Assessment</h2>
        <p class="section-hint">
          Rate how much you agree with each statement.
        </p>

        {{#each scaleQuestions}}
          <div class="question-card psychometric-card">
            <p class="question">{{this.statement}}</p>

            <div class="slider-container">
              <input
                type="range"
                min="1"
                max="5"
                step="1"
                value="3"
                class="scale-slider"
                data-id="{{this.id}}"
              />

              <div class="scale-label" id="label-{{this.id}}">
                Neutral
              </div>
            </div>
          </div>
        {{/each}}
      </section>

      <button id="submitAssessment" class="submit-btn">
        Submit Assessment
      </button>
    </div>
    {{!-- prettier-ignore --}}
    <script defer>
document.getElementById("submitAssessment").addEventListener("click", async () => {

  const mcqAnswers = [];
  const scaleAnswers = [];

  // MCQs
  document.querySelectorAll("[name^='mcq_']").forEach(input => {
    if (input.checked) {
      mcqAnswers.push({
        questionId: input.name.split("_")[1],
        answer: input.value
      });
    }
  });

  // Sliders
  document.querySelectorAll("input[type='range']").forEach(slider => {
    scaleAnswers.push({
      questionId: slider.dataset.id,
      value: slider.value
    });
  });

  const res = await fetch("/submit-career-test", {
    method: "POST",
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify({ mcqAnswers, scaleAnswers })
  });

  if (res.ok) {
    window.location.href = "/career-result";
  }


});


    const SCALE_TEXT = {
  1: "Strongly Disagree",
  2: "Disagree",
  3: "Neutral",
  4: "Agree",
  5: "Strongly Agree",
};

document.addEventListener("DOMContentLoaded", () => {
  document.querySelectorAll(".scale-slider").forEach((slider) => {
    const label = document.getElementById(`label-${slider.dataset.id}`);

    const updateLabel = () => {
      const value = slider.value;
      label.textContent = SCALE_TEXT[value];

      // Optional color feedback
      if (value <= 2) label.style.color = "#dc2626";       // red
      else if (value == 3) label.style.color = "#6b7280"; // gray
      else label.style.color = "#16a34a";                 // green
    };

    slider.addEventListener("input", updateLabel);

    // 🔥 Initialize on page load
    updateLabel();
  });
});

</script>

  </body>
</html>